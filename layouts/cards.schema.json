{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layout",
    "section",
    "title",
    "lead",
    "cards"
  ],
  "properties": {
    "layout": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 52
    },
    "lead": {
      "type": "string",
      "minLength": 1,
      "maxLength": 229
    },
    "cards": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "text"
        ],
        "properties": {
          "kicker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 31
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 61
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 171
          },
          "figure": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label",
              "source",
              "base"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "unit": {
                "enum": [
                  "%",
                  "€",
                  "x",
                  ""
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 74
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "base": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "base": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "title_source": {
      "type": "string",
      "minLength": 1
    },
    "title_base": {
      "type": "string",
      "minLength": 1
    },
    "lead_source": {
      "type": "string",
      "minLength": 1
    },
    "lead_base": {
      "type": "string",
      "minLength": 1
    }
  },
  "x-measured": {
    "on": "2026-11-16",
    "method": "Largest amount of dummy text that renders without overflow, other fields at sample length (scripts/measure.ts)."
  }
}
