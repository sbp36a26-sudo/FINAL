{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layout",
    "section",
    "title"
  ],
  "properties": {
    "layout": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 52
    },
    "title_source": {
      "type": "string",
      "minLength": 1
    },
    "title_base": {
      "type": "string",
      "minLength": 1
    }
  },
  "x-measured": {
    "on": "2026-11-16",
    "method": "Largest amount of dummy text that renders without overflow, other fields at sample length (scripts/measure.ts)."
  }
}
