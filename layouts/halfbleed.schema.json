{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layout",
    "section",
    "title",
    "lead",
    "body",
    "image"
  ],
  "properties": {
    "layout": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 52
    },
    "lead": {
      "type": "string",
      "minLength": 1,
      "maxLength": 229
    },
    "body": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kicker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 27
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 61
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1432
          },
          "table": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "head",
              "rows"
            ],
            "properties": {
              "head": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                }
              }
            }
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "base": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "x-maxTotalChars": 1432,
      "maxItems": 8
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "credit"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 157
        },
        "credit": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "photo_page": {
      "enum": [
        "left",
        "right"
      ]
    },
    "title_source": {
      "type": "string",
      "minLength": 1
    },
    "title_base": {
      "type": "string",
      "minLength": 1
    },
    "lead_source": {
      "type": "string",
      "minLength": 1
    },
    "lead_base": {
      "type": "string",
      "minLength": 1
    }
  },
  "x-measured": {
    "on": "2026-11-16",
    "method": "Largest amount of dummy text that renders without overflow, other fields at sample length (scripts/measure.ts)."
  }
}
