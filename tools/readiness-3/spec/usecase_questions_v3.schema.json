{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "usecase_questions_v3.schema.json",
 "title": "Do you need AI? v3.0 question data",
 "type": "object",
 "required": ["version","schema_version","texts","answers","scoring","step2","must_haves","gate_library","gate_questions","use_cases","none_fits"],
 "$defs": {
  "weight": {"enum": ["B","I","N"]},
  "area": {"enum": ["pe","sk","fi","te","da","or"]},
  "owner": {"enum": ["GM","DH","FIN","IT","OWN","VEN","HR","STAFF"]},
  "qtext": {"type": "string", "minLength": 10, "maxLength": 160, "pattern": "^[^?]*\\?$"},
  "effects": {"type": "object", "additionalProperties": false, "properties": {
     "add": {"type": "array", "items": {"enum": ["ACT_LIMITS","ACT_OFF","GUEST_FACTS","GUEST_STAFF","PEOPLE_DECIDE","PEOPLE_EXPLAIN"]}},
     "sensitive_flag": {"type": "boolean"}, "cap_almost": {"type": "boolean"}, "action": {"type": "string"},
     "contradicts_na": {"type": "array", "items": {"enum": ["m2","m4"]}}, "hide_area": {"enum": ["fi","te"]}, "not_fit": {"type": "string"}}},
  "option": {"type": "object", "required": ["key","label","effects"], "properties": {"key": {"type": "string"}, "label": {"type": "string"}, "effects": {"$ref": "#/$defs/effects"}}},
  "question": {"type": "object", "required": ["id","area","owner","weight","text","why","show_if","hidden_when","source"], "properties": {
     "id": {"type": "string", "pattern": "^[a-z]+-[0-9]+\\.[A-Za-z0-9_-]+$"}, "area": {"$ref": "#/$defs/area"}, "owner": {"$ref": "#/$defs/owner"},
     "weight": {"$ref": "#/$defs/weight"}, "text": {"$ref": "#/$defs/qtext"}, "why": {"type": "string", "minLength": 5},
     "show_if": {"type": ["string","null"], "pattern": "^[A-Za-z0-9_-]+=[a-z]+$"}, "hidden_when": {"type": "array", "items": {"type": "string"}},
     "source": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["original","new","gate"]}}}}},
  "gate": {"type": "object", "required": ["id","kind","asked"], "properties": {
     "id": {"type": "string"}, "kind": {"enum": ["library","custom","auto"]}, "asked": {"type": "boolean"}, "text": {"$ref": "#/$defs/qtext"},
     "options": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/option"}}, "applies": {"type": "string"}, "effects": {"$ref": "#/$defs/effects"}},
     "if": {"properties": {"asked": {"const": true}}}, "then": {"required": ["text","options"]}, "else": {"required": ["applies","effects"]}},
  "orig": {"type": "object", "required": ["qid","action","reason","new_ids"], "properties": {
     "action": {"enum": ["keep","fix","rewrite","split","merge","remove"]}, "reason": {"type": "string", "minLength": 5}}}
 },
 "properties": {
  "version": {"const": "3.0.0"},
  "texts": {"type": "object", "required": ["disclaimer","sensitive_flag","dont_know","doesnt_apply"], "properties": {
     "disclaimer": {"const": "This check does not cover legal requirements. Check those with your adviser before you start."},
     "sensitive_flag": {"const": "This area involves people's personal data or jobs and has extra rules. Ask an adviser before a pilot."},
     "dont_know": {"const": "Don't know yet"}}},
  "step2": {"type": "array", "minItems": 5, "maxItems": 5},
  "must_haves": {"type": "array", "minItems": 11, "maxItems": 11},
  "use_cases": {"type": "array", "minItems": 99, "maxItems": 99, "items": {"type": "object",
     "required": ["id","department","title","sensitive","gates","questions","original_questions"],
     "properties": {"id": {"type": "string", "pattern": "^[a-z]+-[0-9]+$"}, "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}},
        "questions": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/question"}},
        "original_questions": {"type": "array", "items": {"$ref": "#/$defs/orig"}}}}}
 }
}
